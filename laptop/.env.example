ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
# Audio devices by name substring (list: python -m tools.try_voice --devices). Empty = macOS default.
MIC_NAME=
SPEAKER_NAME=
# Echo gate: 1 with a speaker (only "stop"/"wait" interrupts the coach), 0 with headphones.
ECHO_GATE=1
ECHO_TAIL_S=0.3
CAM_URL=http://coach-cam.local:81/stream
CTL_HOST=coach-ctl.local
CLAUDE_MODEL=claude-opus-5-5
COACH_EFFORT=low
# Opus 5.5 fast mode (2x price, faster first sentence). Ignored by other models. 0 = off.
CLAUDE_FAST=1
# Seconds to wait for the first token before the coach speaks the canned step line. Use ~3 with Haiku.
FIRST_TOKEN_TIMEOUT_S=5
# If the main model is too slow, retry once on this model before speaking the canned line. Empty = never retry.
BACKUP_MODEL=claude-haiku-5-5
BACKUP_TIMEOUT_S=3
# How often the coach speaks unprompted: off | gentle (after 45 s of silence) | normal (20 s).
CHECKINS=normal
# 0 = "I'm done" always moves on (trust the user). 1 = the camera may push back once when it clearly disagrees.
PUSHBACK_DONE=0
# Accessibility: 1 = start in plain-language mode (short sentences, one action each, no idioms or numbers).
PLAIN_LANGUAGE=0
YOLO_DEVICE=mps
